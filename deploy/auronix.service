# /etc/systemd/system/auronix.service
# sudo systemctl daemon-reload && sudo systemctl enable --now auronix
# Logs: journalctl -u auronix -f

[Unit]
Description=Auronix site (vendas, webhook Cakto, onboarding)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/auronix
EnvironmentFile=/var/www/auronix/.env
Environment=NODE_ENV=production
# Node 22 próprio do site em /opt/node22 (não mexe no Node do sistema usado por outros apps)
ExecStart=/opt/node22/bin/node src/server.js
Restart=always
RestartSec=3

# Endurecimento
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/var/www/auronix/data
# O banco fica no Supabase; a pasta data guarda só o endereço do painel gerado automaticamente

[Install]
WantedBy=multi-user.target
