{
  "name": "auronix-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site de vendas da Auronix com webhook da Cakto, onboarding e painel admin",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
