# Copie para .env e preencha.  cp .env.example .env

# Endereço público do site (usado nos links dos e-mails)
PUBLIC_URL=https://auronix.cdev.com.br
PORT=3100

# Chave secreta do webhook: a Cakto gera ao criar o webhook
# (Integrações > Webhooks). Copie aqui. Não é a API key / client secret.
CAKTO_WEBHOOK_SECRET=troque-esta-chave

# ---------- Banco (Supabase, projeto CDEV Site, esquema "auronix") ----------
# Session pooler do Supabase com o usuário próprio do site (auronix_app, criado por db/app-role.sql).
# Ele só lê e grava no esquema auronix; não enxerga as tabelas do CDEV Site.
# Use a mesma linha do local.env do seu PC (a senha não vai para o git).
DATABASE_URL=postgresql://auronix_app.qfjvfmfhlmyxlcilhbhn:[SENHA-DO-AURONIX_APP]@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# ---------- Painel ----------
# Endereço secreto do painel (mínimo 12 caracteres). /admin não existe.
# Gere um com:  node -e "console.log('/gestao-' + require('crypto').randomBytes(9).toString('hex'))"
# Se ficar vazio, o site gera um e grava em data/admin-path.txt (aparece no log ao iniciar).
ADMIN_PATH=
# Login pelo Supabase Auth do CDEV Site: entra quem está em ADMIN_EMAILS, com a senha da conta no Supabase.
SUPABASE_URL=https://qfjvfmfhlmyxlcilhbhn.supabase.co
SUPABASE_ANON_KEY=sb_publishable_yMeKxBbUZqHg_utVvlX1fw_WaSbWHlP
ADMIN_EMAILS=cdev.main@gmail.com
# Sem SUPABASE_URL, o painel usa usuário e senha locais:
# ADMIN_USER=admin
# ADMIN_PASS=

# ---------- E-mail ----------
# Resend (recomendado): crie a chave em resend.com/api-keys com permissão "Sending access".
RESEND_API_KEY=
# Remetente: precisa ser de um domínio verificado no Resend
MAIL_FROM="Auronix <contato@auronix.cdev.com.br>"
# Para onde vão as respostas dos clientes. Se contato@auronix.cdev.com.br ainda não recebe e-mails, use seu Gmail.
REPLY_TO=Cdev.main@gmail.com
# Para onde vão os avisos de nova venda, onboarding e mensagens do contato
ADMIN_NOTIFY_EMAIL=Cdev.main@gmail.com

# Alternativa ao Resend: SMTP (só é usado se RESEND_API_KEY estiver vazio)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ---------- Contato exibido no site ----------
CONTACT_EMAIL=contato@auronix.cdev.com.br
# WhatsApp comercial no formato internacional, só números (ex.: 5551999999999). Opcional.
CONTACT_WHATSAPP=

# ---------- Medição (só carrega depois que o visitante aceita os cookies) ----------
GA_ID=G-PY424WTQV5
CLARITY_ID=ywuyag9zls

# Pasta para arquivos locais (só o endereço do painel gerado automaticamente)
DATA_DIR=./data
