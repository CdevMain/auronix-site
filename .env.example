# Copie para .env e preencha.  cp .env.example .env

# Endereço público do site (usado nos links dos e-mails)
PUBLIC_URL=https://auronix.cdev.com.br
PORT=3100

# Chave secreta do webhook. Use o MESMO valor no painel da Cakto
# (Integrações > Webhooks > campo "Chave secreta").
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CAKTO_WEBHOOK_SECRET=troque-esta-chave

# Painel admin em /admin (login HTTP Basic)
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha

# E-mail (SMTP). Sem isso, os links de onboarding só aparecem no log e no /admin.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Auronix <contato@auronix.cdev.com.br>"
# Para onde vão os avisos de nova venda e de onboarding preenchido
ADMIN_NOTIFY_EMAIL=Cdev.main@gmail.com

# Contato exibido no rodapé do site e nos e-mails
CONTACT_EMAIL=contato@auronix.cdev.com.br
# WhatsApp comercial no formato internacional, só números (ex.: 5551999999999). Opcional.
CONTACT_WHATSAPP=

# Pasta do banco SQLite
DATA_DIR=./data
